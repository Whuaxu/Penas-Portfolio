---
// Pioneer CDJ-3000 style jog wheel seen from above. Parts that turn read the
// --deck-angle custom property (and the cue marker --cue-angle) from an ancestor.
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['cdj relative', className]} aria-hidden="true">
	<div class="cdj-well"></div>
	<div class="cdj-side"></div>
	<div class="cdj-light"></div>
	<div class="cdj-bevel"></div>
	<div class="cdj-top"></div>
	<div class="cdj-grip cdj-spin"></div>
	<div class="cdj-screen">
		<svg viewBox="0 0 100 100" class="cdj-position">
			<circle cx="50" cy="50" r="45"></circle>
		</svg>
		<span class="cdj-cue-marker"><span></span></span>
		<span class="cdj-playhead cdj-spin"><span></span></span>
		<span class="cdj-info">
			<slot />
		</span>
	</div>
</div>

<style>
	/* CDJ-3000 style jog wheel */
	.cdj {
		container-type: inline-size;
	}

	.cdj > * {
		position: absolute;
		border-radius: 9999px;
	}

	/* Hole in the deck chassis the jog sits in */
	.cdj-well {
		inset: 0;
		background: #070707;
		box-shadow:
			inset 0 3px 8px rgb(0 0 0 / 0.9),
			0 0 0 1px #262626,
			0 1px 0 1px rgb(255 255 255 / 0.05);
	}

	/* Knurled jog side, seen at the edge */
	.cdj-side {
		inset: 2.5%;
		background:
			radial-gradient(circle, transparent 66%, rgb(0 0 0 / 0.7) 72%, transparent 74%),
			repeating-conic-gradient(#2c2c2c 0deg 1.2deg, #080808 1.2deg 2.4deg);
		box-shadow: 0 6px 16px rgb(0 0 0 / 0.8);
	}

	/* Jog ring illumination: thin LED line at the outer edge of the top */
	.cdj-light {
		inset: 6.3%;
		box-shadow:
			0 0 0 1.5px #f4f7ff,
			0 0 10px 2px rgb(244 247 255 / 0.6),
			inset 0 0 6px 1px rgb(244 247 255 / 0.45);
	}

	/* Thin chrome chamfer around the top plate */
	.cdj-bevel {
		inset: 6.3%;
		background: conic-gradient(#5d5d5d, #e6e6e6, #6a6a6a, #bdbdbd, #555, #e0e0e0, #6a6a6a, #cfcfcf, #5d5d5d);
	}

	/* Matte black top plate with a fixed light reflection */
	.cdj-top {
		inset: 7.3%;
		background:
			linear-gradient(135deg, rgb(255 255 255 / 0.07), transparent 35%, transparent 65%, rgb(255 255 255 / 0.03)),
			radial-gradient(circle at 50% 30%, #1b1b1d, #101011 60%, #0b0b0c);
		box-shadow:
			inset 0 1px 1px rgb(255 255 255 / 0.12),
			inset 0 -4px 10px rgb(0 0 0 / 0.7);
	}

	/* Finger grip: radial grooves around the edge of the top plate, turning with the jog */
	.cdj-grip {
		inset: 7.3%;
		background:
			radial-gradient(circle, rgb(0 0 0 / 0.35) 80%, transparent 96%),
			repeating-conic-gradient(
				rgb(255 255 255 / 0.32) 0deg 0.9deg,
				rgb(0 0 0 / 0.85) 0.9deg 2.2deg,
				#141416 2.2deg 4deg
			);
		mask: radial-gradient(circle, transparent 0 79%, #000 80.5% 97.5%, transparent 99%);
	}

	/* Round jog display */
	.cdj-screen {
		inset: 24%;
		display: grid;
		place-items: center;
		overflow: hidden;
		background: radial-gradient(circle at 50% 45%, #0e131b, #030406 72%);
		box-shadow:
			0 0 0 2px #0a0a0a,
			0 0 0 3.5px #8d8d8d,
			0 0 0 4.5px #2a2a2a,
			inset 0 0 20px rgb(0 0 0 / 0.95);
	}

	/* White position ring around the screen; the playhead is a black notch on it */
	.cdj-position {
		position: absolute;
		inset: 0;
		fill: none;
		stroke: #f2f5fa;
		stroke-width: 5;
		filter: drop-shadow(0 0 2px rgb(255 255 255 / 0.45));
	}

	/* Cue point and playhead markers running around the display edge */
	.cdj-cue-marker,
	.cdj-playhead {
		position: absolute;
		inset: 0;
		border-radius: 9999px;
	}

	.cdj-cue-marker {
		transform: rotate(var(--cue-angle, 0deg));
	}

	/* Half square hanging from the inner edge of the ring, as on the CDJ-3000 */
	.cdj-cue-marker span {
		position: absolute;
		top: 7.5%;
		left: calc(50% - 3%);
		width: 6%;
		height: 3%;
		background: var(--color-cue-b);
	}

	.cdj-playhead span {
		position: absolute;
		top: 1.5%;
		left: calc(50% - 3%);
		width: 6%;
		height: 8%;
		background: #030406;
	}

	.cdj-info {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.6cqi;
		font-family: var(--font-mono);
		color: #e8f1ff;
		text-shadow: 0 0 4px rgb(160 200 255 / 0.55);
	}

	.cdj :global(.cdj-small) {
		font-size: 2.6cqi;
		letter-spacing: 0.08em;
		opacity: 0.75;
	}

	.cdj :global(.cdj-art) {
		width: 30cqi;
		height: auto;
		filter: invert(1) drop-shadow(0 0 3px rgb(255 255 255 / 0.35));
	}

	.cdj-spin {
		transform: rotate(var(--deck-angle, 0deg));
		will-change: transform;
	}
</style>
