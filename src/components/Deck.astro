---
import { Image } from 'astro:assets';
import djLogo from '../assets/dj-logo.png';
import CdjJog from './CdjJog.astro';
import { toLang, useTranslations } from '../i18n/utils';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const t = useTranslations(toLang(Astro.currentLocale));
const grooves = [46, 43, 40, 37, 34, 31, 28, 25];
---

<div data-deck class:list={['relative', className]}>
	<div
		data-deck-platter
		class="relative aspect-square cursor-grab touch-none overflow-hidden select-none active:cursor-grabbing"
		style="--deck-angle: 0deg"
		role="img"
		aria-label={t('deck.platter')}
	>
		<!-- Two-sided deck: flips over when the theme changes -->
		<div class="deck-flip">
			<!-- Light theme: turntable with a vinyl -->
			<div class="deck-face deck-face-front">
				<svg viewBox="0 0 100 100" class="deck-spin size-full">
					<circle cx="50" cy="50" r="49" fill="#0a0a0a" />
					{grooves.map((r) => <circle cx="50" cy="50" r={r} fill="none" stroke="#ffffff" stroke-opacity="0.08" stroke-width="0.4" />)}
					<circle cx="50" cy="3.5" r="0.9" fill="#ffffff" fill-opacity="0.7" />
					<circle cx="50" cy="50" r="17" fill="var(--color-cue-a)" />
					<path id="deck-label-path" d="M50 38 a12 12 0 1 1 -0.01 0" fill="none" />
					<text font-family="var(--font-mono)" font-size="2.3" font-weight="600" fill="#0a0a0a">
						<textPath href="#deck-label-path" textLength="74.6" lengthAdjust="spacing">JAVI PENA · SIDE A · JAVI PENA · SIDE A ·&#160;</textPath>
					</text>
					<circle cx="50" cy="50" r="1.6" fill="#ffffff" />
				</svg>

				<!-- Tonearm -->
				<svg viewBox="0 0 100 100" class="pointer-events-none absolute inset-0 size-full" aria-hidden="true">
					<circle cx="94" cy="8" r="4" fill="#d4d4d4" stroke="#0a0a0a" stroke-width="0.6" />
					<path d="M94 8 L88 52 L76 64" fill="none" stroke="#d4d4d4" stroke-width="2" stroke-linecap="round" />
					<rect x="71" y="61" width="8" height="5" rx="1" transform="rotate(-45 75 63.5)" fill="#0a0a0a" />
				</svg>
			</div>

			<!-- Dark theme: Pioneer CDJ-3000 style jog wheel seen from above -->
			<div class="deck-face deck-face-back">
				<CdjJog class="size-full">
					<span class="cdj-small">B1 · 128.0</span>
					<Image src={djLogo} alt={t('logo.dj')} width={480} class="cdj-art" />
					<span class="cdj-small">SIDE B</span>
				</CdjJog>
			</div>
		</div>
	</div>

	<!-- CUE and PLAY/PAUSE, Pioneer XDJ-RX3 style -->
	<div class="mt-6 flex justify-end gap-4">
		<button type="button" data-deck-cue class="deck-btn" style="--led: var(--color-cue-b)" aria-label={t('deck.cue')}>
			<span class="font-mono text-xs font-semibold tracking-wider">CUE</span>
		</button>
		<button
			type="button"
			data-deck-play
			class="deck-btn"
			style="--led: var(--color-cue-c)"
			aria-label={t('deck.playPause')}
			aria-pressed="true"
		>
			<svg viewBox="0 0 24 12" class="h-3" fill="currentColor" aria-hidden="true">
				<path d="M1 1 L9 6 L1 11 Z" />
				<path d="M11.5 11 L14.5 1" stroke="currentColor" stroke-width="1.2" />
				<rect x="17" y="1" width="2.4" height="10" />
				<rect x="21" y="1" width="2.4" height="10" />
			</svg>
		</button>
	</div>
</div>

<style>
	.deck-btn {
		display: grid;
		place-items: center;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 9999px;
		color: #f5f5f5;
		background: radial-gradient(circle at 50% 35%, #2a2a2a, #0a0a0a 70%);
		/* LED ring: dim by default */
		box-shadow:
			0 0 0 3px color-mix(in srgb, var(--led) 25%, #111),
			0 0 0 5px #0a0a0a,
			0 6px 14px -4px rgb(0 0 0 / 0.5),
			inset 0 1px 0 rgb(255 255 255 / 0.08);
		transition:
			transform 80ms,
			box-shadow 120ms;
		cursor: pointer;
	}

	.deck-btn:active {
		transform: scale(0.94);
	}

	.deck-btn:focus-visible {
		outline: 2px solid var(--color-fg);
		outline-offset: 6px;
	}

	.deck-btn[data-led='on'],
	.deck-btn[data-led='blink'] {
		box-shadow:
			0 0 0 3px var(--led),
			0 0 0 5px #0a0a0a,
			0 0 18px 2px color-mix(in srgb, var(--led) 70%, transparent),
			inset 0 1px 0 rgb(255 255 255 / 0.08);
	}

	.deck-btn[data-led='blink'] {
		animation: led-blink 0.5s steps(2, start) infinite;
	}

	/* Dark theme: the gear lights up */
	:global([data-theme='dark']) .deck-btn {
		box-shadow:
			0 0 0 3px color-mix(in srgb, var(--led) 40%, #111),
			0 0 0 5px #0a0a0a,
			0 0 10px 0 color-mix(in srgb, var(--led) 20%, transparent),
			inset 0 1px 0 rgb(255 255 255 / 0.08);
	}

	:global([data-theme='dark']) .deck-btn[data-led='on'],
	:global([data-theme='dark']) .deck-btn[data-led='blink'] {
		box-shadow:
			0 0 0 3px var(--led),
			0 0 0 5px #0a0a0a,
			0 0 32px 8px color-mix(in srgb, var(--led) 75%, transparent),
			inset 0 0 10px 0 color-mix(in srgb, var(--led) 35%, transparent);
	}

	/*
	 * Flip between the vinyl (front, light) and the CDJ (back, dark).
	 * At rest nothing is 3D-transformed: phones rasterize 3D layers at a reduced
	 * scale, which made the deck look blurry. The 3D setup only exists while
	 * [data-flipping] is set by the script during the theme change.
	 */
	[data-deck-platter][data-flipping] {
		perspective: 1400px;
	}

	.deck-flip,
	.deck-face {
		position: absolute;
		inset: 0;
	}

	.deck-face-back,
	:global([data-theme='dark']) .deck-face-front {
		visibility: hidden;
	}

	:global([data-theme='dark']) .deck-face-back {
		visibility: visible;
	}

	[data-flipping] .deck-flip {
		transform-style: preserve-3d;
		animation: deck-flip 800ms cubic-bezier(0.65, 0, 0.35, 1) both;
	}

	[data-flipping='to-light'] .deck-flip {
		animation-direction: reverse;
	}

	[data-flipping] .deck-face {
		visibility: visible;
		backface-visibility: hidden;
	}

	[data-flipping] .deck-face-back {
		transform: rotateY(180deg);
	}

	@keyframes deck-flip {
		from {
			transform: rotateY(0deg);
		}
		to {
			transform: rotateY(180deg);
		}
	}

	.deck-spin {
		transform: rotate(var(--deck-angle));
		will-change: transform;
	}

	@keyframes led-blink {
		50% {
			box-shadow:
				0 0 0 3px color-mix(in srgb, var(--led) 25%, #111),
				0 0 0 5px #0a0a0a,
				0 6px 14px -4px rgb(0 0 0 / 0.5),
				inset 0 1px 0 rgb(255 255 255 / 0.08);
		}
	}
</style>

<script>
	// Turntable-like deck: the angle accumulates and speed eases toward a target,
	// so play, pause (vinyl brake), hover speed-ups and scratches never jump.
	const PLAY_SPEED = 60; // deg/s
	const HOVER_SPEED = 300;
	const START_EASING = 3;
	const BRAKE_SECONDS = 2; // vinyl brake: time to a full stop, whatever the speed
	const SPIN_DOWN_SECONDS = 0.6; // a flicked record with the motor off
	const HAND_STILL_MS = 60; // no pointer movement for this long = hand holding the record still

	const wrap = (deg: number) => ((deg % 360) + 360) % 360;

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('[data-deck]').forEach((deck) => {
		const platter = deck.querySelector<HTMLElement>('[data-deck-platter]')!;
		const flipper = platter.querySelector<HTMLElement>('.deck-flip')!;
		const cueBtn = deck.querySelector<HTMLButtonElement>('[data-deck-cue]')!;
		const playBtn = deck.querySelector<HTMLButtonElement>('[data-deck-play]')!;

		let playing = !reduceMotion;
		let previewing = false; // CUE held while paused on the cue point
		let hovering = false;
		let cueAngle = 0;
		let angle = 0;
		let speed = playing ? PLAY_SPEED : 0;
		let brakeDecel = 0; // deg/s², fixed when the brake starts
		let scratching = false; // record held by the pointer
		let handAngle = 0; // last pointer angle around the spindle
		let handSpeed = 0; // deg/s the hand is moving the record at
		let lastHandMove = 0;
		let last = 0;
		let frame = 0;

		const atCue = () => !playing && !previewing && angle === cueAngle;
		const running = () => playing || previewing;

		const render = () => {
			platter.style.setProperty('--cue-angle', `${cueAngle}deg`);
			playBtn.dataset.led = playing ? 'on' : 'blink';
			playBtn.setAttribute('aria-pressed', String(playing));
			cueBtn.dataset.led = previewing || atCue() ? 'on' : playing ? 'off' : 'blink';
			// Lets the rest of the page (now playing bar) react to the deck
			document.documentElement.dataset.deck = running() ? 'playing' : 'paused';
		};

		const tick = (now: number) => {
			const dt = last ? Math.min((now - last) / 1000, 0.1) : 0;
			last = now;
			if (scratching) {
				// The hand drives the record (angle is set in pointermove)
				if (now - lastHandMove > HAND_STILL_MS) handSpeed = 0;
				speed = handSpeed;
			} else {
				if (running()) {
					const target = hovering && playing ? HOVER_SPEED : PLAY_SPEED;
					speed += (target - speed) * Math.min(1, dt * START_EASING);
				} else {
					// Constant deceleration, like a real platter slowing down
					speed = Math.sign(speed) * Math.max(0, Math.abs(speed) - brakeDecel * dt);
				}
				angle = wrap(angle + speed * dt);
			}
			platter.style.setProperty('--deck-angle', `${angle}deg`);
			frame = requestAnimationFrame(tick);
		};

		const jumpToCue = () => {
			angle = cueAngle;
			speed = 0;
			platter.style.setProperty('--deck-angle', `${angle}deg`);
		};

		playBtn.addEventListener('click', () => {
			playing = !playing;
			if (!playing) brakeDecel = speed / BRAKE_SECONDS;
			render();
		});

		cueBtn.addEventListener('pointerdown', (event) => {
			if (event.button !== 0) return;
			if (playing) {
				// Back to the cue point and pause
				playing = false;
				jumpToCue();
			} else if (angle !== cueAngle) {
				// Paused elsewhere: set a new cue point here
				cueAngle = angle;
			} else {
				// Paused on the cue point: play while held
				previewing = true;
				speed = PLAY_SPEED;
				cueBtn.setPointerCapture(event.pointerId);
			}
			render();
		});

		const endPreview = () => {
			if (!previewing) return;
			previewing = false;
			jumpToCue();
			render();
		};
		cueBtn.addEventListener('pointerup', endPreview);
		cueBtn.addEventListener('pointercancel', endPreview);

		// Keyboard: Enter/Space on CUE behaves like a click (no hold preview)
		cueBtn.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			event.preventDefault();
			cueBtn.dispatchEvent(new PointerEvent('pointerdown', { button: 0 }));
			endPreview();
		});

		platter.addEventListener('pointerenter', () => (hovering = true));
		platter.addEventListener('pointerleave', () => (hovering = false));

		// Scratch: grab the record and it follows the hand around the spindle
		const pointerAngle = (event: PointerEvent) => {
			const box = platter.getBoundingClientRect();
			const x = event.clientX - (box.left + box.width / 2);
			const y = event.clientY - (box.top + box.height / 2);
			return (Math.atan2(y, x) * 180) / Math.PI;
		};

		platter.addEventListener('pointerdown', (event) => {
			if (event.button !== 0) return;
			event.preventDefault();
			platter.setPointerCapture(event.pointerId);
			scratching = true;
			handAngle = pointerAngle(event);
			handSpeed = 0;
			lastHandMove = performance.now();
		});

		platter.addEventListener('pointermove', (event) => {
			if (!scratching) return;
			const now = performance.now();
			const current = pointerAngle(event);
			const delta = wrap(current - handAngle + 180) - 180; // shortest way round
			const elapsed = (now - lastHandMove) / 1000;
			if (elapsed > 0) handSpeed = handSpeed * 0.5 + (delta / elapsed) * 0.5;
			angle = wrap(angle + delta);
			handAngle = current;
			lastHandMove = now;
		});

		const release = () => {
			if (!scratching) return;
			scratching = false;
			// Let go with the hand's speed: the motor pulls it back or it spins down
			speed = handSpeed;
			if (!running()) brakeDecel = Math.abs(speed) / SPIN_DOWN_SECONDS;
			render();
		};
		platter.addEventListener('pointerup', release);
		platter.addEventListener('pointercancel', release);

		// Only animate while visible
		new IntersectionObserver(([entry]) => {
			cancelAnimationFrame(frame);
			if (entry.isIntersecting) {
				last = 0;
				frame = requestAnimationFrame(tick);
			}
		}).observe(deck);

		// Animate the flip only when the theme changes; the faces are flat at rest
		let currentTheme = document.documentElement.dataset.theme;
		new MutationObserver(() => {
			const theme = document.documentElement.dataset.theme;
			if (theme === currentTheme) return;
			currentTheme = theme;
			if (reduceMotion) return;
			platter.dataset.flipping = theme === 'dark' ? 'to-dark' : 'to-light';
		}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
		flipper.addEventListener('animationend', (event) => {
			if (event.target === flipper) delete platter.dataset.flipping;
		});

		render();
	});
</script>
