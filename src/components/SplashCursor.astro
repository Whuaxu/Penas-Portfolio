---
import type { FluidOptions } from '../scripts/fluid';

type Props = FluidOptions;

// Options travel to the client script as JSON on the canvas
const options = JSON.stringify(Astro.props);
---

<div class="pointer-events-none fixed top-0 left-0 z-0 size-full" aria-hidden="true">
	<canvas id="fluid" class="block h-screen w-screen" data-options={options}></canvas>
</div>

<script>
	import { initFluid } from '../scripts/fluid';

	const canvas = document.getElementById('fluid') as HTMLCanvasElement | null;

	// Start the fluid once the browser is idle, so compiling its shaders
	// doesn't compete with the first paint (it only shows after the pointer moves)
	const start = () => canvas && initFluid(canvas, JSON.parse(canvas.dataset.options ?? '{}'));
	if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1500 });
	else setTimeout(start, 200);
</script>
