---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../i18n/ui';
import { toLang, useTranslations } from '../i18n/utils';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

// Path without the locale prefix, so the switch keeps the current page
const path = Astro.url.pathname.replace(/^\/en(\/|$)/, '/').replace(/^\//, '');
---

<nav aria-label={t('lang.switch')} class="flex items-center font-mono text-[11px] uppercase">
	{
		(Object.keys(languages) as Lang[]).map((code, i) => (
			<>
				{i > 0 && <span class="px-1.5 text-line" aria-hidden="true">/</span>}
				<a
					href={getRelativeLocaleUrl(code, path)}
					hreflang={code}
					lang={code}
					aria-current={code === lang ? 'page' : undefined}
					class:list={[
						'transition-colors',
						code === lang ? 'font-semibold text-fg' : 'text-muted hover:text-fg',
					]}
				>
					{code}
				</a>
			</>
		))
	}
</nav>
