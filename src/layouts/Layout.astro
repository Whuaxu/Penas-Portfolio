---
import '@fontsource-variable/inter';
import '@fontsource-variable/martian-mono/wdth.css';
import '../styles/global.css';
import SplashCursor from '../components/SplashCursor';
import { toLang, useTranslations } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
}

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

const { title = t('meta.title'), description = t('meta.description') } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" />
		<script is:inline>
			// Apply the saved theme (or the system one) before the first paint
			(() => {
				let saved = null;
				try {
					saved = localStorage.getItem('theme');
				} catch {}
				const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
				const theme = dark ? 'dark' : 'light';
				document.documentElement.dataset.theme = theme;
				document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0d0d0f' : '#ffffff');
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-dvh overflow-x-hidden">
		<a href="#content" class="skip-link liquid-glass liquid-glass-strong">{t('a11y.skip')}</a>
		<!-- Liquid glass refraction (used by .liquid-glass through backdrop-filter, Chromium only) -->
		<svg width="0" height="0" class="absolute" aria-hidden="true">
			<filter id="liquid-glass" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
				<feTurbulence type="fractalNoise" baseFrequency="0.008 0.012" numOctaves="2" seed="7" result="noise" />
				<feGaussianBlur in="noise" stdDeviation="2" result="softNoise" />
				<feDisplacementMap in="SourceGraphic" in2="softNoise" scale="28" xChannelSelector="R" yChannelSelector="G" />
			</filter>
		</svg>
		<!-- Dark theme: club smoke (grey dye with turbulent, wispy physics) -->
		<SplashCursor
			client:only="react"
			DENSITY_DISSIPATION={0.5}
			VELOCITY_DISSIPATION={3}
			DARK_STYLE="smoke"
			DARK_COLOR_INTENSITY={0.03}
			DARK_SHADING={true}
			DARK_PHYSICS={{ CURL: 30, SPLAT_RADIUS: 0.35, DENSITY_DISSIPATION: 1.2, VELOCITY_DISSIPATION: 1.5, SPLAT_FORCE: 4000 }}
		/>
		<div class="relative z-10">
			<slot />
		</div>
	</body>
</html>
