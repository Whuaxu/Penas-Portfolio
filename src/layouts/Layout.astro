---
import '@fontsource-variable/inter';
import '@fontsource-variable/martian-mono/wdth.css';
import '../styles/global.css';
import SplashCursor from '../components/SplashCursor.astro';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { profile } from '../data/profile';
import { languages, type Lang } from '../i18n/ui';
import { toLang, useTranslations } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
}

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

const { title = t('meta.title'), description = t('meta.description') } = Astro.props;

// Set by Vercel during its builds
const onVercel = process.env.VERCEL === '1';

// SEO: canonical URL, language alternates and share image
const path = Astro.url.pathname.replace(/^\/en(\/|$)/, '/').replace(/^\//, '');
const canonical = getAbsoluteLocaleUrl(lang, path);
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({ code, href: getAbsoluteLocaleUrl(code, path) }));
const ogLocale = { es: 'es_ES', en: 'en_US' } as const;
const ogImage = new URL(`/og/${lang}.png`, Astro.site).href;

const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.fullName,
	alternateName: profile.name,
	url: Astro.site?.href,
	jobTitle: lang === 'es' ? 'Desarrollador de software' : 'Software Developer',
	address: { '@type': 'PostalAddress', addressLocality: 'Carballo', addressRegion: 'Galicia', addressCountry: 'ES' },
	alumniOf: 'Universidade de Vigo',
	sameAs: [profile.links.github, profile.links.linkedin],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" />
		<script is:inline>
			// Apply the saved theme (or the system one) before the first paint
			(() => {
				let saved = null;
				try {
					saved = localStorage.getItem('theme');
				} catch {}
				const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
				const theme = dark ? 'dark' : 'light';
				document.documentElement.dataset.theme = theme;
				document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0d0d0f' : '#ffffff');
			})();
		</script>
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
		{alternates.map(({ code, href }) => <link rel="alternate" hreflang={code} href={href} />)}
		<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('es', path)} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={profile.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocale[lang]} />
		{alternates.filter(({ code }) => code !== lang).map(({ code }) => <meta property="og:locale:alternate" content={ogLocale[code]} />)}
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t('meta.ogAlt')} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify(person)} />
		<!-- Vercel Web Analytics (cookieless; the script only exists on Vercel deployments) -->
		{
			onVercel && (
				<>
					<script is:inline>
						window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
					</script>
					<script is:inline defer src="/_vercel/insights/script.js"></script>
				</>
			)
		}
	</head>
	<body class="min-h-dvh overflow-x-hidden">
		<a href="#content" class="skip-link liquid-glass liquid-glass-strong">{t('a11y.skip')}</a>
		<!-- Liquid glass refraction (used by .liquid-glass through backdrop-filter, Chromium only) -->
		<svg width="0" height="0" class="absolute" aria-hidden="true">
			<filter id="liquid-glass" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
				<feTurbulence type="fractalNoise" baseFrequency="0.008 0.012" numOctaves="2" seed="7" result="noise" />
				<feGaussianBlur in="noise" stdDeviation="2" result="softNoise" />
				<feDisplacementMap in="SourceGraphic" in2="softNoise" scale="28" xChannelSelector="R" yChannelSelector="G" />
			</filter>
		</svg>
		<!-- Dark theme: club smoke (grey dye with turbulent, wispy physics) -->
		<SplashCursor
			DENSITY_DISSIPATION={0.5}
			VELOCITY_DISSIPATION={3}
			DARK_STYLE="smoke"
			DARK_COLOR_INTENSITY={0.03}
			DARK_SHADING={true}
			DARK_PHYSICS={{ CURL: 30, SPLAT_RADIUS: 0.35, DENSITY_DISSIPATION: 1.2, VELOCITY_DISSIPATION: 1.5, SPLAT_FORCE: 4000 }}
		/>
		<div class="relative z-10">
			<slot />
		</div>
	</body>
</html>
