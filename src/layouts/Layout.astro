---
import '@fontsource-variable/inter';
import '@fontsource-variable/martian-mono/wdth.css';
import '../styles/global.css';
import SplashCursor from '../components/SplashCursor';
import { toLang, useTranslations } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
}

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

const { title = t('meta.title'), description = t('meta.description') } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-dvh overflow-x-hidden">
		<SplashCursor client:only="react" DENSITY_DISSIPATION={0.5} VELOCITY_DISSIPATION={3} />
		<div class="relative z-10">
			<slot />
		</div>
	</body>
</html>
